#!/bin/sh
# Removed: Debian's identity files come back.
set -e
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    for f in /usr/lib/os-release /etc/issue /etc/issue.net /etc/motd; do
        dpkg-divert --package orbit-release --remove --rename --divert "$f.debian" "$f" >/dev/null
    done
fi
exit 0

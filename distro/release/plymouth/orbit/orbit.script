# Orbit Linux's boot and shutdown screen (docs/PLANO-DISTRO.md §11): black,
# the mark in the middle, the moon travelling the outer orbit
# counter-clockwise (3.6 s a turn) and the open inner orbit turning the
# other way (2.2 s). Images from make-images.sh, in the mark's 100-unit box.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
size = Math.Int(Math.Min(W, H) * 0.22);
unit = size / 100;
cx = Window.GetX() + W / 2;
cy = Window.GetY() + H / 2;
left = cx - size / 2;
top = cy - size / 2;

base.image = Image("base.png").Scale(size, size);
base.sprite = Sprite(base.image);
base.sprite.SetPosition(left, top, 1);

inner.image = Image("inner.png").Scale(size, size);
inner.sprite = Sprite(inner.image);
inner.sprite.SetPosition(left, top, 2);

moon.size = Math.Int(14 * unit);
moon.sprite = Sprite(Image("moon.png").Scale(moon.size, moon.size));
moon.radius = 38 * unit;
# Where the mark draws it: (66.1, 84.4) from the centre (50, 50).
moon.start = Math.ATan2(34.4, 16.1);

FPS = 50;
frame = 0;

fun place(t) {
    # Screen y grows downwards: a smaller angle is counter-clockwise.
    a = moon.start - 2 * Math.Pi * t / 3.6;
    moon.sprite.SetPosition(cx + Math.Cos(a) * moon.radius - moon.size / 2,
                            cy + Math.Sin(a) * moon.radius - moon.size / 2, 3);
    # Rotate turns clockwise for a positive angle.
    inner.sprite.SetImage(inner.image.Rotate(2 * Math.Pi * t / 2.2));
    # A short fade in.
    o = Math.Min(t / 0.4, 1);
    base.sprite.SetOpacity(o);
    inner.sprite.SetOpacity(o);
    moon.sprite.SetOpacity(o);
}

fun refresh_callback() {
    global.frame = global.frame + 1;
    place(global.frame / FPS);
}
Plymouth.SetRefreshFunction(refresh_callback);
place(0);

# --- Questions (a disk's passphrase), under the mark ---

TEXT_Y = top + size + Math.Int(size * 0.25);
prompt.sprite = Sprite();
prompt.sprite.SetZ(10);
bullet.image = Image("bullet.png").Scale(Math.Int(unit * 6) + 4, Math.Int(unit * 6) + 4);
MAX_BULLETS = 32;
for (i = 0; i < MAX_BULLETS; i++) {
    bullets[i] = Sprite(bullet.image);
    bullets[i].SetOpacity(0);
    bullets[i].SetZ(10);
}

fun show_prompt(text) {
    img = Image.Text(text, 0.85, 0.87, 0.91, 1, "Sans 13");
    prompt.sprite.SetImage(img);
    prompt.sprite.SetPosition(cx - img.GetWidth() / 2, TEXT_Y);
    prompt.sprite.SetOpacity(1);
    return img.GetHeight();
}

fun hide_prompt() {
    prompt.sprite.SetOpacity(0);
    for (i = 0; i < MAX_BULLETS; i++)
        bullets[i].SetOpacity(0);
}

fun display_password_callback(text, count) {
    if (!text) text = "Password";
    h = show_prompt(text);
    n = Math.Min(count, MAX_BULLETS);
    step = bullet.image.GetWidth() * 1.6;
    x = cx - (n * step) / 2;
    y = TEXT_Y + h + bullet.image.GetHeight();
    for (i = 0; i < MAX_BULLETS; i++) {
        if (i < n) {
            bullets[i].SetPosition(x + i * step, y);
            bullets[i].SetOpacity(1);
        } else
            bullets[i].SetOpacity(0);
    }
}

fun display_question_callback(text, entry) {
    show_prompt(text + " " + entry);
    for (i = 0; i < MAX_BULLETS; i++)
        bullets[i].SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(hide_prompt);

# --- Messages (a check of the disk, say), at the foot of the screen ---

message.sprite = Sprite();
message.sprite.SetZ(10);
fun message_callback(text) {
    img = Image.Text(text, 0.6, 0.63, 0.68, 1, "Sans 11");
    message.sprite.SetImage(img);
    message.sprite.SetPosition(cx - img.GetWidth() / 2, Window.GetY() + H - img.GetHeight() * 3);
}
Plymouth.SetMessageFunction(message_callback);

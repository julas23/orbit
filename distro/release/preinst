#!/bin/sh
# Debian's identity files are put aside (diverted) for Orbit Linux's.
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for f in /usr/lib/os-release /etc/issue /etc/issue.net /etc/motd; do
        dpkg-divert --package orbit-release --add --rename --divert "$f.debian" "$f" >/dev/null
    done
fi
exit 0

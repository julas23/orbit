#!/bin/sh
# The Live session opens by itself: Orbit-Login starts the live user's
# session at boot unlocked, and the session never locks on idle. The
# installed system never gets these (docs/PLANO-DISTRO.md §6.1).
set -e

cat > /etc/orbit/login.yaml <<'YAML'
# Live image: the live user, unlocked at boot.
user: orbit
command: orbit-core
vt: 1
YAML

mkdir -p /etc/skel/.config/orbit
cat > /etc/skel/.config/orbit/core.yaml <<'YAML'
idle_lock: 0
YAML

# Marks the Live image for whatever needs to tell it from an installed system.
touch /etc/orbit/live

systemctl enable orbit-login.service

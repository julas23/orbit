#!/bin/sh
# Orbit Linux: the encrypted /home is offered (docs/PLANO-DISTRO.md §6.4),
# on a disk with /home on a partition of its own. Before 06user-setup,
# which clears the user's password from debconf: when the answer is yes,
# that password is kept in /tmp/orbit-home-pw (the installer's memory) for
# late.sh, which encrypts /home with it and then removes it.
set -e
. /usr/share/debconf/confmodule
log() { logger -t orbit-home "$*"; }

[ "$(cat /tmp/orbit-layout 2>/dev/null)" = separate ] || exit 0
grep -q " /target/home " /proc/mounts || { log "no /home partition"; exit 0; }

debconf-loadtemplate orbit /orbit/orbit.templates
if [ -f /orbit/test.conf ]; then
	. /orbit/test.conf
	answer=${ENCRYPT_HOME:-false}
else
	db_input critical orbit/encrypt-home || true
	db_go || true
	db_get orbit/encrypt-home
	answer=$RET
fi
log "encrypt /home: $answer"
[ "$answer" = true ] || exit 0

if db_get passwd/user-password-crypted && [ -n "$RET" ]; then
	log "the password was given encrypted: /home is not encrypted"
	exit 0
fi
db_get passwd/user-password
[ -n "$RET" ] || { log "no password: /home is not encrypted"; exit 0; }
umask 077
printf '%s' "$RET" > /tmp/orbit-home-pw

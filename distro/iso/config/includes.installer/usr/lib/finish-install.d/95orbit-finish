#!/bin/sh
# Orbit Linux, among the installer's last steps, after the Live's packages
# are gone (docs/PLANO-DISTRO.md §6.2), with Orbit's install steps
# (/orbit/steps.sh):
#   - the language chosen in the installer, in /etc/locale.conf: the
#     installer leaves the Live image's C.UTF-8 there;
#   - the keyboard chosen kept first, a second layout added;
#   - the UKI made again from the final initramfs (without live-boot), and
#     any other UKI removed.
set -e
T=/target
LOCALE=$(debconf-get debian-installer/locale 2>/dev/null || true)
[ -n "$LOCALE" ] || LOCALE=pt_BR.UTF-8
target() { in-target "$@"; }
. /orbit/steps.sh

orbit_locale_conf
logger -t orbit "LANG=$LOCALE"
orbit_keyboard
logger -t orbit "keyboard: $(grep ^XKBLAYOUT $T/etc/default/keyboard)"
orbit_final_ukis 2>&1 | logger -t orbit

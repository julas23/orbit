#!/bin/sh
# Removed: gcr's prompter answers again.
set -e
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    dpkg-divert --package orbit-prompter --remove --rename \
        --divert /usr/share/dbus-1/services/org.gnome.keyring.SystemPrompter.service.gcr \
        /usr/share/dbus-1/services/org.gnome.keyring.SystemPrompter.service
fi
exit 0

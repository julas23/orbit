#!/usr/bin/env bash
# orbit-session — starts (or restarts) Orbit-Panel and Orbit-Dock for a
# Wayland session, in the right order, Orbit-Notify when no notification
# server is running (sway's config used to start it), Orbit-Aigent when
# it is installed and not running yet, and Orbit-Remote-Server likewise
# when remote.yaml says `start: true`.
#
#   orbit-session [--fallback COMMAND]
#
# Order matters: each surface reserves its edge and the compositor lays them
# out as they appear, so the panel goes first (full height) and the dock
# after it (top edge, to the right of the panel).
#
# The panel is considered up when its GTK application id appears on the
# session bus. If it does not within 3 s — e.g. a machine without the
# gtk4-layer-shell library — COMMAND runs instead (an older panel), so the
# session is never left without one.
set -u

# A program beside this script, else the one on PATH: an install in
# ~/.local/bin may lack some of them, which the system's (/usr/local/bin)
# then provides.
BIN=$(dirname "$(readlink -f "$0")")
bin() {
  if [ -x "$BIN/$1" ]; then echo "$BIN/$1"; else command -v "$1"; fi
}
PANEL_ID=io.github.julas23.Orbit.Panel
FALLBACK=""
if [ "${1:-}" = --fallback ]; then
  FALLBACK=${2:-}
fi

# Restart: stop what is running.
pkill -x orbit-dock 2>/dev/null
pkill -x orbit-panel 2>/dev/null
for _ in $(seq 1 20); do
  pgrep -x orbit-panel >/dev/null || pgrep -x orbit-dock >/dev/null || break
  sleep 0.1
done

setsid "$(bin orbit-panel)" >/dev/null 2>&1 < /dev/null &

up=false
for _ in $(seq 1 30); do
  if busctl --user status "$PANEL_ID" >/dev/null 2>&1; then
    up=true
    break
  fi
  sleep 0.1
done

if ! $up; then
  echo "orbit-session: orbit-panel did not start" >&2
  pkill -x orbit-panel 2>/dev/null
  if [ -n "$FALLBACK" ]; then
    echo "orbit-session: running the fallback: $FALLBACK" >&2
    exec sh -c "$FALLBACK"
  fi
  exit 1
fi

# Give the panel's surface a moment to be mapped before the dock's.
sleep 0.5
setsid "$(bin orbit-dock)" >/dev/null 2>&1 < /dev/null &

# Notifications (the panel's "syncing before leaving" among them). Left
# running on a restart, so the centre keeps its history; a second launch
# would only toggle the centre.
if ! busctl --user status org.freedesktop.Notifications >/dev/null 2>&1; then
  setsid "$(bin orbit-notify)" --background >/dev/null 2>&1 < /dev/null &
fi

# The voice assistant, likewise left running on a restart (a request may be
# under way). Its log, kept from the last start only, is
# ~/.local/state/orbit/aigent.log.
AIGENT=$(bin orbit-aigent)
if [ -n "$AIGENT" ] && ! pgrep -x orbit-aigent >/dev/null; then
  STATE=${XDG_STATE_HOME:-$HOME/.local/state}/orbit
  mkdir -p "$STATE"
  RUST_LOG=${RUST_LOG:-info,whisper_rs=warn} setsid "$AIGENT" >"$STATE/aigent.log" 2>&1 < /dev/null &
fi

# The remote server, likewise left running on a restart (a client may be
# connected), only when ~/.config/orbit/remote.yaml (else
# /etc/orbit/remote.yaml) says `start: true`. Its log is
# ~/.local/state/orbit/remote.log.
REMOTE=$(bin orbit-remote-server)
REMOTE_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/orbit/remote.yaml
[ -f "$REMOTE_CONF" ] || REMOTE_CONF=/etc/orbit/remote.yaml
remote() { grep -Eq "^$1:[[:space:]]*true([[:space:]]|#|$)" "$REMOTE_CONF" 2>/dev/null; }
# (pgrep -x sees only 15 characters of a name: matched on the command.)
if [ -n "$REMOTE" ] && remote start && ! pgrep -u "$(id -u)" -f '^[^ ]*orbit-remote-server serve' >/dev/null; then
  STATE=${XDG_STATE_HOME:-$HOME/.local/state}/orbit
  mkdir -p "$STATE"
  if remote virtual; then set -- serve --virtual; else set -- serve; fi
  setsid "$REMOTE" "$@" >"$STATE/remote.log" 2>&1 < /dev/null &
fi
